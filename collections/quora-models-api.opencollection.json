{
  "opencollection": "1.0.0",
  "info": {
    "name": "Poe Chat Models API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.poe.com/v1/models"
          },
          "docs": "List the AI models and bots available through the Poe API."
        }
      ]
    }
  ],
  "bundled": true
}